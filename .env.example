# Generate local values with: python3 scripts/setup_env.py
# Do not commit .env. Values below are placeholders, never real credentials.
POSTGRES_PASSWORD=replace-with-generated-value
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=replace-with-at-least-12-characters
DATABASE_URL=sqlite:///./jana.db
# Optional host ports. Containers always use 3000/8000 internally.
WEB_PORT=3000
API_PORT=8000
# Optional AI Jana wording. Leave disabled for the existing extractive answers.
# Keep the real key in local .env or the deployment secret store, never in Git.
LLM_PROVIDER=disabled
# LLM_API_KEY=replace-with-provider-api-key
# OpenAI-compatible HTTPS Chat Completions endpoint and a model available to your account.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=200
# Local run: start app.mock_zup on 8300. Docker uses its internal URL.
ZUP_BASE_URL=http://127.0.0.1:8300/hs/jana/v1
ZUP_MODE=mock
# Fixed reference date for reproducible Academy demo deadlines in mock mode.
ACADEMY_DEMO_AS_OF=2026-10-17
ZUP_AUTH_TYPE=bearer
ZUP_API_TOKEN=replace-with-at-least-32-random-characters
# Real 1C: use ZUP_MODE=real and an HTTPS URL. Choose either Bearer above or Basic below.
# For Docker, set ZUP_DOCKER_BASE_URL to an address reachable from containers.
# ZUP_DOCKER_BASE_URL=https://zup-test.example.kz/company/hs/jana/v1
# ZUP_USERNAME=jana-service
# ZUP_PASSWORD=replace-with-1c-service-password
# Paths below must be mounted read-only into migrate, backend and zup-worker.
# ZUP_CA_BUNDLE=/run/secrets/company-ca.pem
# ZUP_CLIENT_CERT=/run/secrets/jana-client.crt
# ZUP_CLIENT_KEY=/run/secrets/jana-client.key
# ZUP_TIMEOUT_SECONDS=5
# ZUP_VERIFY_TLS=true
# Only for an isolated test network; never for production:
# ZUP_ALLOW_INSECURE_HTTP=false

# Documentolog Business: separate persistent mock included in Docker Compose.
DOCUMENTOLOG_MODE=mock
DOCUMENTOLOG_API_KEY=replace-with-at-least-32-random-characters
DOCUMENTOLOG_PORT=8400
# For local Python use, start app.mock_documentolog separately and set:
# DOCUMENTOLOG_BASE_URL=http://127.0.0.1:8400
# DOCUMENTOLOG_BROWSER_URL=http://localhost:8400
# DOCUMENTOLOG_PUBLIC_URL=http://127.0.0.1:8000
# DOCUMENTOLOG_CALLBACK_URL=http://127.0.0.1:8000
# Real Business requires API access, sender IIN/BIN and publicly reachable HTTPS.
# DOCUMENTOLOG_MODE=real
# DOCUMENTOLOG_DOCKER_BASE_URL=https://apibusiness.documentolog.com
# DOCUMENTOLOG_BROWSER_URL=https://apibusiness.documentolog.com
# DOCUMENTOLOG_SENDER=replace-with-12-digit-sender
# DOCUMENTOLOG_PUBLIC_URL=https://hr-test.example.kz
# DOCUMENTOLOG_CALLBACK_URL=https://hr-test.example.kz
